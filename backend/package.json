{
  "name": "agendamento-consultas-api",
  "version": "0.0.1",
  "description": "API REST do sistema de agendamento de consultas",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "migration:run": "node --env-file-if-exists=.env ./node_modules/typeorm/cli.js migration:run -d dist/banco/fonte-de-dados.js",
    "migration:revert": "node --env-file-if-exists=.env ./node_modules/typeorm/cli.js migration:revert -d dist/banco/fonte-de-dados.js",
    "lint": "oxlint --type-aware src/"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2"
  }
}
